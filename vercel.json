{
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)scripts/news_history.json'",
  "functions": {
    "api/stream_audio.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/stream_audio",
      "destination": "/api/stream_audio"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-history",
      "schedule": "5 21 * * *"
    },
    {
      "path": "/api/cron/cleanup-history",
      "schedule": "5 23 * * *"
    }
  ]
}
